# Copy to .env and fill in. Values containing "$" (argon2 hashes) must be wrapped in single quotes.

# ---------------------------------------------------------------- general
SITE_NAME=HomeNet
# Long random string: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Public URL guests open (also returned by the /captive-portal API for DHCP option 114)
PUBLIC_GUEST_URL=https://wifi.home.example
# Public URL of the admin side, used for the OIDC redirect (https://wifi-admin.home.example)
PUBLIC_ADMIN_URL=https://wifi-admin.home.example
# Keep true when your reverse proxy serves HTTPS (it should).
SESSION_COOKIE_SECURE=true
LOG_LEVEL=INFO
# Image the server pulls (published by GitHub Actions). Pin a build with :sha-<commit> to roll back.
PORTAL_IMAGE=ghcr.io/shreyasajj/guest-wifi-portal:latest

# ---------------------------------------------------------------- OPNsense
OPNSENSE_URL=https://192.168.1.1
OPNSENSE_KEY=
OPNSENSE_SECRET=
# true, false, or a path to a CA bundle mounted into the container
OPNSENSE_VERIFY_TLS=false
# Captive portal zone id (Services > Captive Portal > Administration, column "Zone ID")
OPNSENSE_ZONE_ID=0
# Guest interface device name(s) as shown in Interfaces > Diagnostics > ARP Table "Interface" column,
# e.g. vlan0.20 or igb1_vlan20. Leave empty to search all interfaces.
GUEST_INTERFACES=vlan0.20
# zone  = allowed MACs in the captive portal zone only
# alias = MAC alias only (GUEST_AUTH_MACS) referenced by your firewall rules
# both  = both (recommended, see README "Network design")
ACCESS_MODE=both
OPNSENSE_ALIAS_NAME=GUEST_AUTH_MACS
# DHCP server on the guest VLAN: kea, dnsmasq, isc or none
DHCP_BACKEND=kea
# A lease counts as "seen" if it was (re)acquired within this many seconds
DHCP_RECENT_SECONDS=600

# ---------------------------------------------------------------- Nextcloud CardDAV
CARDDAV_URL=https://cloud.example.com/remote.php/dav/addressbooks/users/alice/contacts/
CARDDAV_USER=alice
# Nextcloud > Personal settings > Security > Devices & sessions > Create new app password
CARDDAV_PASSWORD=
CARDDAV_VERIFY_TLS=true
CONTACT_CACHE_SECONDS=300
# On a cache miss, refetch at most this often
CONTACT_MIN_REFRESH_SECONDS=15
# Region used to read phone numbers written without a country code
PHONE_DEFAULT_REGION=US

# ---------------------------------------------------------------- network trust
# IPs/CIDRs of your reverse proxy. Only these may set X-Forwarded-For.
TRUSTED_PROXIES=192.168.1.20/32
# Admin UI and API are only served to these networks (Home Assistant must be inside one)
ADMIN_ALLOWED_NETWORKS=192.168.1.0/24

# ---------------------------------------------------------------- admin sign-in
ADMIN_USERNAME=admin
# docker compose run --rm portal python -m app.hashpw
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$replace$me'
# Authelia OIDC (leave OIDC_ISSUER empty to disable)
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=guest-wifi
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email groups
# Comma list of groups allowed in; empty = any user Authelia lets through
OIDC_ALLOWED_GROUPS=admins
OIDC_LABEL=Authelia

# ---------------------------------------------------------------- Home Assistant API
# Comma list of bearer tokens: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKENS=

# ---------------------------------------------------------------- approvals
APPROVAL_TTL_SECONDS=600
APPROVAL_COOLDOWN_SECONDS=20

# ---------------------------------------------------------------- login rate limit
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BACKOFF_BASE_SECONDS=60
LOGIN_BACKOFF_MAX_SECONDS=3600

# ---------------------------------------------------------------- workers
PRESENCE_POLL_SECONDS=30
AWAY_GRACE_SECONDS=300
RECONCILE_SECONDS=60
# A registered device whose MAC you delete from the zone's Allowed MAC addresses (or the alias):
#   revoke = revoke the device; if it was the person's last device, remove the person too
#   readd  = put the MAC back (treat OPNsense as out of sync)
MISSING_MAC_ACTION=revoke
# Remove allowed MACs not seen for this many days. 0 = never (devices keep access until you revoke them)
MAC_EXPIRY_DAYS=0
EVENT_RETENTION_DAYS=14
